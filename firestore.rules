rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admin/data/clientRequests/{id} {
      // Public contact form submissions
      allow create: if
        request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.role is string
        && request.resource.data.interest is string
        && request.resource.data.status == 'New'
        && request.resource.data.keys().hasAny(['createdAt']);

      // Portal consultants (Firebase Auth)
      allow read, update, delete: if request.auth != null;
    }

    match /admin/data/capabilities/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string);
      allow delete: if request.auth != null;
    }

    match /admin/data/blogs/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.capabilityId is string
        && request.resource.data.capabilityId.size() > 0
        && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string);
      allow delete: if request.auth != null;
    }

    match /admin/data/careerCategories/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.order is int;
      allow delete: if request.auth != null;
    }

    match /admin/data/careerRoles/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0;
      allow delete: if request.auth != null;
    }

    match /admin/data/teamDesignations/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.order is int;
    }

    match /admin/data/teamMembers/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.designationId is string
        && request.resource.data.designationId.size() > 0
        && request.resource.data.designation is string
        && request.resource.data.designation.size() > 0
        && request.resource.data.email is string
        && (request.resource.data.email.size() == 0
          || request.resource.data.email.matches('.*@.*\\..*'))
        && request.resource.data.phone is string
        && request.resource.data.status in ['Active', 'On Leave']
        && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string);
    }

    match /admin/data/careerApplications/{id} {
      // Public career application submissions
      allow create: if
        request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.resumeUrl is string
        && request.resource.data.resumeUrl.size() > 0
        && request.resource.data.resumePath is string
        && request.resource.data.resumePath.size() > 0
        && request.resource.data.roleId is string
        && request.resource.data.roleId.size() > 0
        && request.resource.data.roleTitle is string
        && request.resource.data.roleTitle.size() > 0
        && request.resource.data.coverLetter is string
        && request.resource.data.coverLetter.size() > 0
        && request.resource.data.keys().hasAny(['createdAt']);

      // Portal consultants (Firebase Auth)
      allow read, update, delete: if request.auth != null;
    }

    // Allow reading/writing the sentinel admin/data doc (seed/migration metadata)
    match /admin/data {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
