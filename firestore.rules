rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactRequests/{id} {
      // Public contact form submissions
      allow create: if
        request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.role is string
        && request.resource.data.interest is string
        && request.resource.data.status == 'New'
        && request.resource.data.keys().hasAny(['createdAt']);

      // Portal consultants (Google Auth)
      allow read, update, delete: if request.auth != null;
    }

    match /capabilities/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string);
      allow delete: if request.auth != null;
    }

    match /blogs/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.capabilityId is string
        && request.resource.data.capabilityId.size() > 0
        && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string);
      allow delete: if request.auth != null;
    }
  }
}
